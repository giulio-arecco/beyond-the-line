  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "L'ordine di ritirata non \xE8 mai arrivato. Non ce n'\xE8 stato il tempo.
    Quella che doveva essere un'avanzata decisiva si \xE8 trasformata in una rotta
    disordinata sotto il fuoco dell'artiglieria nemica. Il tuo plotone \xE8 stato
    disperso, i tuoi compagni inghiottiti dal fumo e dal caos.\n\nFino a ieri eri
    un caporale, un ingranaggio di una macchina militare precisa. Oggi sei solo un
    sopravvissuto isolato oltre le linee nemiche. Hai perso il contatto radio. Del
    tuo equipaggiamento ti rimangono solo una razione militare e un rotolo di bende.
    \n\nHai camminato per ore nel fango, guidato solo dall'istinto di sopravvivenza,
    fino a crollare esausto tra le mura diroccate di una vecchia fattoria abbandonata.\n\nLa
    salvezza, oltre il confine, \xE8 a giorni di marcia verso ovest. Tra te e casa
    c'\xE8 un intero paese ostile, ferito dalla guerra. Nessuno verr\xE0 a prenderti.
    Da questo momento, ogni scelta \xE8 tua."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a9655470c9b057f4eb27ce3b166747df, type: 2}
